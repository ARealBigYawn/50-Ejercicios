# Con la variable del precio de la comida, calculamos los gastos diaros multiplicando los dias y semanas necesarias.

precio_comida = 1250

gasto_diario = precio_comida * 7
print(f"Gasto diario en comida: {gasto_diario} monedas") # Gasto diario en comida: 8750 monedas

gasto_semanal = gasto_diario * 7
print(f"Gasto semanal en comida: {gasto_semanal} monedas") # Gasto semanal en comida: 61250 monedas

gasto_anual = gasto_diario * 365
print(f"Gasto anual en comida: {gasto_anual} monedas") # Gasto anual en comida: 3193750 monedas

monedas_hobbit = 500000
calculo_dias = monedas_hobbit // gasto_diario
print(f"Con 500,000 monedas, el hobbit puede comer durante {calculo_dias} días") # Con 500,000 monedas, el hobbit puede comer durante 57 días


# Con el operador % podemos calcular las monedas que sobraran al dividir.
monedas_restantes = monedas_hobbit % gasto_diario
print(f"Al hobbit le sobran {monedas_restantes} monedas") # Al hobbit le sobran 1250 monedas
