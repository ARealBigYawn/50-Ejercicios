leguas = int(input("Ingrese una distancia en leguas: "))

# Convertimos leguas a kilómetros y metros. 1 legua = 4.828 km

distancia_km = leguas * 4.828
distancia_metros = distancia_km * 1000

# Calculamos los días que tardaría un hobbit y un caballo en recorrer la distancia.

dias_hobbit = distancia_km / 30
dias_caballo = distancia_km / 90

print(f"Distancia en leguas: {leguas}")
print(f"Distancia en kilómetros: {distancia_km}km")
print(f"Distancia en metros: {distancia_metros}m")
print(f"Dias que tardaría un hobbit caminando: {dias_hobbit:.2f}")
print(f"Dias que tardaría un caballo: {dias_caballo:.2f}")

if dias_hobbit > 30:
    print("Necesitarás las Águilas.")